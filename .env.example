# Supabase থেকে নিন: Dashboard → Project Settings → API keys
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role অথবা sb_secret_... key>

# এর নিচের সব optional
# API_ACCESS_TOKEN=long-random-token
# FACE_DISTANCE_THRESHOLD=0.50
# CORS_ORIGINS=*
# SQLITE_PATH=./attendance.db
